{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build:vercel",
  "builds": [{ "src": "api/index.ts", "use": "@vercel/node" }],
  "routes": [{
    "src": "/(.*)",
    "dest": "api/index.ts",
    "methods": ["GET","POST","PUT","PATCH","DELETE","OPTIONS","HEAD"]
  }]
}
